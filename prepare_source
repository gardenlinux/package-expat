apt-get install --no-install-recommends -y curl ca-certificates

pkg=expat
version_orig=2.8.4
version="$version_orig-1"
version_suffix=gl0~bp2150

debian_snapshot="20260907T082400Z"

mkdir -p "$dir/src"
curl -L https://snapshot.debian.org/archive/debian/$debian_snapshot/pool/main/e/expat/expat_$version_orig.orig.tar.gz | gzip -d | tee "$dir/orig.tar" | tar --extract --strip-components 1 --directory "$dir/src"
mkdir -p "$dir/src/debian"
curl -L https://snapshot.debian.org/archive/debian/$debian_snapshot/pool/main/e/expat/expat_$version.debian.tar.xz | xz -d | tee "$dir/debian.tar" | tar --extract --strip-components 1 --directory "$dir/src/debian"
